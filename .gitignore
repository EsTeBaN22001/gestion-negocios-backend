# ==========================================
# .gitignore — Backend ASP.NET Core .NET 8
# ==========================================

# Compilación y artefactos .NET
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates
*.suo

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Archivos de configuración local y secretos
*.local.json
appsettings.Production.json
secrets.json

# Almacenamiento físico de uploads generados en tiempo de ejecución
src/GestionNegocios.Api/wwwroot/uploads/*
!src/GestionNegocios.Api/wwwroot/uploads/**/.gitkeep

# Pruebas y cobertura
TestResults/
coverage/
*.trx

# Logs y SO
*.log
.DS_Store
Thumbs.db
