              "raw": "{{baseUrl}}/api/sucursales?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sucursales"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
