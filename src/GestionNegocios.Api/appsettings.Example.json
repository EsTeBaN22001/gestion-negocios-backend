{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comentario_laragon_xampp": "Para entornos locales con Laragon o XAMPP sin contraseña, usar: Server=localhost;Port=3306;Database=gestion_negocios;User=root;Password=;CharSet=utf8mb4;",
    "_comentario_mysql_custom": "Para entornos con usuario específico (ej. appuser / change-me), usar:",
    "DefaultConnection": "Server=localhost;Port=3306;Database=gestion_negocios;User=root;Password=;CharSet=utf8mb4;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Key": "DevelopmentSecretKeyForLocalTestingMustBeAtLeast32BytesLong!",
    "Issuer": "GestionNegociosApi",
    "Audience": "GestionNegociosFrontend",
    "DurationMinutes": 60
  },
  "Seed": {
    "AdminEmail": "admin@gestionnegocios.local",
    "AdminPassword": "Admin123*",
    "EmployeeEmail": "empleado@gestionnegocios.local",
    "EmployeePassword": "Empleado123*"
  }
}
